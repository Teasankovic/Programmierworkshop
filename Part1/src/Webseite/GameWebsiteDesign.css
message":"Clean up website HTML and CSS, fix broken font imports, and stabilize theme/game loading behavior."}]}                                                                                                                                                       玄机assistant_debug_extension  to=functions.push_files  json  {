:root {
    --bg-dark: #230c0f;
    --accent-orange: #de6b21;
    --accent-yellow: #f9a01b;
    --text-main: #fce8cd;
    --card-bg: #36171b;
    --preview-bg: #140507;
    --gradient-start: #f39c12;
    --gradient-mid: #e67e22;
    --gradient-end: #d35400;
    --title-color: #230c0f;
    --title-shadow: #f9a01b;
}

:root[data-theme="light"] {
    --bg-dark: #f5ebe0;
    --accent-orange: #b84a14;
    --accent-yellow: #d35400;
    --text-main: #36171b;
    --card-bg: #e3d5ca;
    --preview-bg: #d5bdaf;
    --gradient-start: #d35400;
    --gradient-mid: #e67e22;
    --gradient-end: #f39c12;
    --title-color: #36171b;
    --title-shadow: #fbd38d;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: 'Rubik', sans-serif;
    overflow-x: hidden;
    transition: background-color 0.4s ease, color 0.4s ease, border-color 0.4s ease;
}

button {
    font: inherit;
}

.theme-switch-container {
    position: absolute;
    top: 25px;
    right: 25px;
    z-index: 100;
}

.theme-btn {
    background-color: transparent;
    color: var(--title-color);
    border: 2px solid var(--title-color);
    padding: 8px 18px;
    font-family: 'Cinzel', serif;
    font-weight: 900;
    font-size: 0.85rem;
    cursor: pointer;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    transition: all 0.2s ease;
}

.theme-btn:hover {
    background-color: var(--title-color);
    color: var(--text-main);
}

.hero-section {
    background: linear-gradient(to bottom, var(--gradient-start), var(--gradient-mid), var(--gradient-end), var(--bg-dark));
    min-height: 45vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    position: relative;
}

.main-title {
    font-family: 'Aleo', serif;
    font-weight: 900;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    color: var(--title-color);
    text-shadow: 4px 4px 0 var(--title-shadow);
    letter-spacing: -1px;
    margin-bottom: 15px;
    text-transform: uppercase;
}

.subtitle {
    font-family: 'Cinzel', serif;
    font-size: 1.1rem;
    color: var(--title-color);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 4px;
}

.main-content {
    max-width: 1200px;
    margin: 40px auto;
    padding: 0 20px;
    position: relative;
    z-index: 10;
}

.games-section {
    background-color: var(--card-bg);
    border: 2px solid var(--accent-orange);
    border-radius: 6px;
    padding: 40px;
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15);
}

.section-title {
    font-family: 'Cinzel', serif;
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    text-align: center;
    margin-bottom: 45px;
    color: var(--accent-orange);
    font-weight: 900;
    letter-spacing: 3px;
    text-transform: uppercase;
}

.games-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 35px;
}

.game-card {
    background-color: var(--bg-dark);
    border: 2px solid var(--accent-orange);
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
}

.game-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 8px 24px var(--accent-orange);
}

.game-preview-box {
    background-color: var(--preview-bg);
    height: 220px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 2px solid var(--accent-orange);
    position: relative;
}

.placeholder-icon {
    font-size: 3.5rem;
    z-index: 1;
}

.game-info {
    padding: 25px;
    text-align: center;
}

.game-info h3 {
    font-family: 'Cinzel', serif;
    font-size: 1.5rem;
    font-weight: 900;
    margin-bottom: 12px;
    color: var(--accent-orange);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.game-info p {
    font-size: 0.95rem;
    margin-bottom: 25px;
    min-height: 48px;
    line-height: 1.5;
    opacity: 0.85;
}

.play-btn {
    background-color: var(--accent-orange);
    color: #fff;
    border: none;
    padding: 14px 24px;
    font-family: 'Cinzel', serif;
    font-weight: 900;
    font-size: 1rem;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: 4px;
    width: 100%;
    letter-spacing: 2px;
    transition: background-color 0.2s ease, color 0.2s ease;
}

.play-btn:hover {
    background-color: var(--accent-yellow);
    color: #230c0f;
}

.game-overlay {
    position: fixed;
    inset: 0;
    background: rgba(17, 17, 17, 0.92);
    z-index: 9999;
    text-align: center;
    padding-top: 20px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.game-overlay.hidden {
    display: none;
}

.close-game-btn {
    padding: 12px 25px;
    background: #ff4d4d;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    font-size: 16px;
    margin-top: 10px;
}

.loading-text {
    color: var(--text-main);
    font-family: 'Rubik', sans-serif;
    font-size: 18px;
    margin-top: 18px;
}

.error-text {
    color: #ff4d4d;
}

.footer {
    text-align: center;
    padding: 40px 20px;
    background-color: var(--preview-bg);
    border-top: 3px solid var(--accent-orange);
    font-size: 0.9rem;
}

.footer-logo {
    margin-top: 15px;
    font-family: 'Cinzel', serif;
    font-weight: 900;
    font-size: 1rem;
    letter-spacing: 3px;
    color: var(--accent-orange);
}

@media (max-width: 640px) {
    .games-section {
        padding: 25px 16px;
    }

    .theme-switch-container {
        top: 15px;
        right: 15px;
    }

    .theme-btn {
        padding: 7px 12px;
        font-size: 0.75rem;
    }

    .subtitle {
        letter-spacing: 2px;
    }
}

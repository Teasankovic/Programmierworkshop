<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tea's small Arcade</title>
    <meta name="description" content="Tea's small Arcade - eine kleine Spieleauswahl mit Flappy Bird, Blackjack und Snake.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aleo:wght@400;700;900&family=Cinzel:wght@400;600;700;900&family=Rubik:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="GameWebsiteDesign.css">
</head>
<body>
    <div class="theme-switch-container">
        <button class="theme-btn" id="themeToggle" type="button" aria-label="Toggle light mode">☀️ Light Mode</button>
    </div>

    <header class="hero-section">
        <div class="header-overlay">
            <h1 class="main-title">Tea's small Arcade</h1>
            <p class="subtitle">Classic games you can play</p>
        </div>
    </header>

    <main class="main-content">
        <section class="games-section" aria-labelledby="game-section-title">
            <h2 id="game-section-title" class="section-title">Choose your game</h2>

            <div class="games-grid">
                <article class="game-card" aria-label="Flappy Bird game card">
                    <div class="game-preview-box">
                        <div class="placeholder-icon" aria-hidden="true">🦤</div>
                    </div>
                    <div class="game-info">
                        <h3>Flappy Bird</h3>
                        <p>Dodge the pipes and beat your own highscore!</p>
                        <button class="play-btn" type="button" data-game="flappy.jar">Play now</button>
                    </div>
                </article>

                <article class="game-card" aria-label="Blackjack game card">
                    <div class="game-preview-box">
                        <div class="placeholder-icon" aria-hidden="true">🃏</div>
                    </div>
                    <div class="game-info">
                        <h3>Blackjack</h3>
                        <p>Challenge the Dealer. Do you come closer to 21?</p>
                        <button class="play-btn" type="button" data-game="blackjack.jar">Play now</button>
                    </div>
                </article>

                <article class="game-card" aria-label="Snake game card">
                    <div class="game-preview-box">
                        <div class="placeholder-icon" aria-hidden="true">🐍</div>
                    </div>
                    <div class="game-info">
                        <h3>Snake</h3>
                        <p>Eat the apples, grow infinitely, but don't crash into the wall!</p>
                        <button class="play-btn" type="button" data-game="snake.jar">Play now</button>
                    </div>
                </article>
            </div>
        </section>
    </main>

    <div id="game-overlay" class="game-overlay hidden" role="dialog" aria-live="polite" aria-modal="true">
        <button id="closeGame" class="close-game-btn" type="button" aria-label="Close game">← Zurück zur Spieleauswahl</button>
        <div id="loading-text" class="loading-text">Spiel lädt... Bitte kurz warten...</div>
    </div>

    <footer class="footer">
        <div class="footer-logo">Tea's small Arcade</div>
    </footer>

    <script src="https://cjrtnc.leaningtech.com/5.0/loader.js"></script>
    <script>
        const toggleButton = document.getElementById('themeToggle');

        function updateThemeButton() {
            const isLight = document.documentElement.getAttribute('data-theme') === 'light';
            toggleButton.textContent = isLight ? '🌙 Dark Mode' : '☀️ Light Mode';
            toggleButton.setAttribute('aria-label', isLight ? 'Switch to dark mode' : 'Switch to light mode');
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const nextTheme = currentTheme === 'light' ? '' : 'light';
            document.documentElement.setAttribute('data-theme', nextTheme);
            localStorage.setItem('arcade-theme', nextTheme);
            updateThemeButton();
        }

        const storedTheme = localStorage.getItem('arcade-theme');
        if (storedTheme === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
        }
        updateThemeButton();

        toggleButton.addEventListener('click', toggleTheme);

        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.play-btn').forEach((button) => {
                button.addEventListener('click', () => {
                    const gameName = button.dataset.game;
                    if (gameName) {
                        const params = new URLSearchParams(window.location.search);
                        params.set('game', gameName);
                        window.history.replaceState({}, '', `${window.location.pathname}?${params.toString()}`);
                        startGame(gameName);
                    }
                });
            });

            document.getElementById('closeGame').addEventListener('click', () => {
                const params = new URLSearchParams(window.location.search);
                params.delete('game');
                const queryString = params.toString();
                const url = queryString ? `${window.location.pathname}?${queryString}` : window.location.pathname;
                window.history.replaceState({}, '', url);
                document.getElementById('game-overlay').classList.add('hidden');
            });

            const urlParams = new URLSearchParams(window.location.search);
            const gameToPlay = urlParams.get('game');
            if (gameToPlay) {
                startGame(gameToPlay);
            }
        });

        async function startGame(gameToPlay) {
            const overlay = document.getElementById('game-overlay');
            const loadingText = document.getElementById('loading-text');
            overlay.classList.remove('hidden');

            try {
                loadingText.textContent = 'Laufzeitumgebung bereit... Starte Spielfeld...';
                await cheerpjInit({ version: 11 });

                cheerpjCreateDisplay(800, 600);

                const currentPath = window.location.pathname.replace(/\/[^/]*$/, '');
                const absoluteJarPath = '/app' + currentPath + '/' + gameToPlay;
                console.log('CheerpJ lädt von virtuellem Pfad:', absoluteJarPath);

                await cheerpjRunJar(absoluteJarPath);
                loadingText.style.display = 'none';
            } catch (error) {
                loadingText.innerHTML = '<span class="error-text">Fehler: Das Spiel konnte nicht geladen werden.</span>';
                console.error(error);
            }
        }
    </script>
</body>
</html>

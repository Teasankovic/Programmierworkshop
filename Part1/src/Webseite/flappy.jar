package FlappyBird;

import java.awt.*;
import java.awt.event.*;
import java.io.InputStream;
import java.util.ArrayList;
import java.util.prefs.Preferences;
import javax.swing.*;

public class FlappyBirdGame extends JPanel implements ActionListener, KeyListener {
private static final long serialVersionUID = 1L;

int boardWidth = 360;
int boardHeight = 640;
// Images
Image backgroundImg;
Image birdImg;
Image topPipeImg;
Image bottomPipeImg;

// bird
int birdX = boardWidth / 8;
int birdY = boardHeight / 2;
int birdWidth = 34;
int birdHeight = 24;

class Bird {
int x = birdX;
int y = birdY;
int width = birdWidth;
int height = birdHeight;
Image img;

Bird(Image img) {
this.img = img;
}
}

// PIPES
int pipeX = boardWidth;
int pipeY = 0;
int pipeWidth = 64;
int pipeHeight = 512;

class Pipe {
int x = pipeX;
int y = pipeY;
int width = pipeWidth;
int height = pipeHeight;
Image img;
boolean passed = false;

Pipe(Image img) {
this.img = img;
}
}

// Game Logic
Bird bird;

int velocityX = -4;
// moves pipes to the left side
// simulates bird moving

int velocityY = 0;
int gravity = 1;

ArrayList<Pipe> pipes;

    Timer gameLoop;
    Timer placePipesTimer;

    boolean gameOver = false;

    double score = 0;
    int highscore = 0;

    // Speichert den Highscore dauerhaft
    Preferences preferences = Preferences.userNodeForPackage(FlappyBirdGame.class);

    // Font
    Font flappyBirdFont;
    FlappyBirdGame() {
    setPreferredSize(new Dimension(boardWidth, boardHeight));
    setFocusable(true);
    addKeyListener(this);

    /*
    * Load Images
    *
    * Das mit getResource ist so ähnlich wie das mit
    * dem cd und dem Slash am Ende.
    * Der Pfad muss richtig eingefügt sein,
    * damit es funktioniert.
    */
    backgroundImg = new ImageIcon(getClass().getResource("/FlappyBird/flappybirdbg.png")).getImage();
    birdImg = new ImageIcon(getClass().getResource("/FlappyBird/flappybird.png")).getImage();
    topPipeImg = new ImageIcon(getClass().getResource("/FlappyBird/toppipe.png")).getImage();
    bottomPipeImg = new ImageIcon(getClass().getResource("/FlappyBird/bottompipe.png")).getImage();
    // Originalen Flappy-Bird-Font laden
    loadFont();
    // Gespeicherten Highscore laden
    highscore = preferences.getInt("highscore", 0);
    bird = new Bird(birdImg);
    pipes = new ArrayList<Pipe>();
        placePipesTimer = new Timer(1500, new ActionListener() {

        @Override
        public void actionPerformed(ActionEvent e) {
        placePipes();
        }
        }
        );
        placePipesTimer.start();


        /* Game loop 1000 / 60 = ungefähr 16,6 Millisekunde pro Schleifendurchlauf.*/
        gameLoop = new Timer(1000 / 60, this);
        gameLoop.start();
        }
        private void loadFont() {
        try {
        InputStream fontStream = getClass().getResourceAsStream("/FlappyBird/flappybird.ttf");

        if (fontStream != null) {
        flappyBirdFont = Font.createFont(Font.TRUETYPE_FONT, fontStream).deriveFont(Font.BOLD, 32f);
        GraphicsEnvironment graphicsEnvironment = GraphicsEnvironment.getLocalGraphicsEnvironment();
        graphicsEnvironment.registerFont(flappyBirdFont);
        fontStream.close();

        } else {
        System.out.println("flappybird.ttf wurde nicht gefunden. " + "Arial wird verwendet.");

        flappyBirdFont = new Font("Arial", Font.BOLD, 32);
        }

        } catch (Exception e) {
        e.printStackTrace();flappyBirdFont = new Font("Arial", Font.BOLD, 32);
        }
        }

        public void placePipes() {
        /*
        (0 - 1) * pipeHeight / 2 ergibt einen Wert von 0 bis 256. Das obere Rohr bekommt dadurch eine zufällige Position.*/
        int randomPipeY = (int) (pipeY - pipeHeight / 4 - Math.random() * (pipeHeight / 2));
        int openingSpace = boardHeight / 4;

        Pipe topPipe = new Pipe(topPipeImg);
        topPipe.y = randomPipeY;
        pipes.add(topPipe);

        Pipe bottomPipe = new Pipe(bottomPipeImg);
        bottomPipe.y = topPipe.y + pipeHeight + openingSpace;
        pipes.add(bottomPipe);
        }

        @Override
        protected void paintComponent(Graphics graphics) {
        super.paintComponent(graphics);
        draw(graphics);
        }

        public void draw(Graphics graphics) {
        /*Background ..Die x- und y-Koordinaten starten in der oberen linken Ecke. Deshalb verwenden wir hier 0 und 0. */
        graphics.drawImage(backgroundImg, 0, 0, boardWidth, boardHeight, null);

        // Bird
        graphics.drawImage(bird.img, bird.x, bird.y, bird.width, bird.height, null);

        // Pipes
        for (int i = 0; i < pipes.size(); i++) {
        Pipe pipe = pipes.get(i);
        graphics.drawImage(pipe.img, pipe.x, pipe.y, pipe.width, pipe.height, null);
        }

        // Score und Highscore
        graphics.setFont(flappyBirdFont);
        if (gameOver) {
        drawOutlinedString(graphics, "Game Over", 75, 250);

        drawOutlinedString(graphics, "Score: " + (int) score, 85, 300);

        drawOutlinedString(graphics, "Highscore: " + highscore, 65, 350);

        graphics.setFont(flappyBirdFont.deriveFont(Font.PLAIN, 18f));

        drawOutlinedString(graphics, "Drücke SPACE zum Neustarten", 55, 400);

        } else {
        drawOutlinedString(graphics, "Score: " + (int) score, 10, 35);

        drawOutlinedString(graphics, "Highscore: " + highscore, 10, 70);
        }
        }

        /*Zeichnet Text mit einer schwarzen Umrandung.   Der Text wird zuerst mehrmals leicht versetzt in Schwarz gezeichnet. Danach wird der eigentliche Text in Weiß darüber gezeichnet.
        */
        private void drawOutlinedString(Graphics graphics, String text, int x, int y) {
        // Schwarze Umrandung
        graphics.setColor(Color.BLACK);
        graphics.drawString(text, x - 2, y);
        graphics.drawString(text, x + 2, y);
        graphics.drawString(text, x, y - 2);
        graphics.drawString(text, x, y + 2);

        // Zusätzliche diagonale Umrandung
        graphics.drawString(text, x - 2, y - 2);
        graphics.drawString(text, x + 2, y - 2);
        graphics.drawString(text, x - 2, y + 2);
        graphics.drawString(text, x + 2, y + 2);

        // Haupttext
        graphics.setColor(Color.WHITE);
        graphics.drawString(text, x, y);
        }

        public void move() {
        // Gravity
        velocityY += gravity;
        bird.y += velocityY;

        // Der Vogel kann nicht über den oberen Rand fliegen
        bird.y = Math.max(bird.y, 0);

        for (int i = 0; i < pipes.size(); i++) {
        Pipe pipe = pipes.get(i);

        // Die Rohre bewegen sich nach links
        pipe.x += velocityX;

        /* Score ..Es gibt zwei Rohre pro Rohrpaar. Deshalb gibt jedes Rohr 0,5 Punkte.  0,5 * 2 = 1 Punkt pro Rohrpaar.*/
        if (!pipe.passed && bird.x > pipe.x + pipe.width) {
        pipe.passed = true;
        score += 0.5;
        updateHighscore();
        }
        // Kollision prüfen
        if (collision(bird, pipe)) {
        gameOver = true;
        }
        }

        // Prüfen, ob der Vogel unten herausfällt
        if (bird.y > boardHeight) {
        gameOver = true;
        }
        }

        /*
        * Aktualisiert den Highscore und speichert ihn.
        */
        private void updateHighscore() {
        int currentScore = (int) score;

        if (currentScore > highscore) {
        highscore = currentScore;

        preferences.putInt("highscore", highscore);
        }
        }

        public boolean collision(Bird a, Pipe b) {
        return a.x < b.x + b.width  // a's obere linke Ecke erreicht b's obere rechte Ecke nicht
        && a.x + a.width > b.x      // a's obere rechte Ecke erreicht b's obere linke Ecke
        && a.y < b.y + b.height     // a's obere linke Ecke erreicht b's untere linke Ecke nicht
        && a.y + a.height > b.y;    // a's untere linke Ecke erreicht b's obere linke Ecke
        }

        @Override
        public void actionPerformed(ActionEvent e) {
        move();
        repaint();

        if (gameOver) {
        placePipesTimer.stop();
        gameLoop.stop();
        }
        }

        @Override
        public void keyTyped(KeyEvent e) {
        // Wird nicht benötigt
        }

        @Override
        public void keyPressed(KeyEvent e) {
        if (e.getKeyCode() == KeyEvent.VK_SPACE) {

        if (gameOver) { //Das Spiel wird mit dem Reset aller Bedingungen neugestartet.
        restartGame();

        } else {
        // Vogel nach oben bewegen
        velocityY = -9;
        }
        }
        }

        private void restartGame() {
        bird.y = birdY;
        velocityY = 0;
        pipes.clear();
        score = 0;
        gameOver = false;

        gameLoop.start();
        placePipesTimer.start();
        requestFocusInWindow();
        }

        @Override
        public void keyReleased(KeyEvent e) {
        // Wird nicht benötigt
        }
        import javax.swing.*;



        public class FlappyBird {
        public static void main(String[] args ) throws Exception{
        int boardWidth = 360;
        int boardHeigth = 640;

        JFrame frame = new JFrame("Flappy Bird");
        frame.setSize(boardWidth,boardHeigth);
        frame.setLocationRelativeTo(null);
        frame.setResizable(false);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        FlappyBirdGame flappyBird = new FlappyBirdGame();
        frame.add(flappyBird);
        frame.pack(); //Dient dazu das die anzeige über dem spiel nicht mit in die größe eingerechnet wird
        flappyBird.requestFocus();
        frame.setVisible(true);

        }package FlappyBird;

        import javax.swing.*;



        public class FlappyBird {
        public static void main(String[] args ) throws Exception{
        int boardWidth = 360;
        int boardHeigth = 640;

        JFrame frame = new JFrame("Flappy Bird");
        frame.setSize(boardWidth,boardHeigth);
        frame.setLocationRelativeTo(null);
        frame.setResizable(false);
        frame.setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);

        FlappyBirdGame flappyBird = new FlappyBirdGame();
        frame.add(flappyBird);
        frame.pack(); //Dient dazu das die anzeige über dem spiel nicht mit in die größe eingerechnet wird
        flappyBird.requestFocus();
        frame.setVisible(true);

        }
        }
        }


        }